#!/bin/bash

# Runs the envtest integration suites with kro's production feature-gate
# defaults (every alpha gate off); see test/README.md.

set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd ${REPO_ROOT}

# Build
go build ./cmd/...

make test WHAT=integration-default-gates
